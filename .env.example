# .env - Copy this to .env and fill in your values

# Database
PGHOST=localhost
PGPORT=5432
PGDATABASE=xtoystories
PGUSER=postgres
PGPASSWORD=your_password

# Server
PORT=3000
NODE_ENV=development

# JWT & Auth
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
ADMIN_TOKEN=your_admin_token_change_this

# Email (for moderation notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
ADMIN_EMAIL=admin@xtoystories.com

# Solana (optional - for future wallet integration)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TREASURY_SECRET_KEY=your_solana_secret_key_base64
REWARD_ENABLED=false

# Telegram (optional - for future bot integration)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_GROUP_ID=your_group_id

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
